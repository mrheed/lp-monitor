# Wallets whose LP positions mark the position column, comma separated.
# An entry may carry a label after an equals sign; without one the address is shortened.
# Labels are worth setting once you track more than one wallet.
#
#   LP_WALLETS=0xaaa...=Main,0xbbb...=Hot,0xccc...
#
# Copy this file to .env.local and fill in your addresses.
LP_WALLETS=0x0000000000000000000000000000000000000000=Main

# Telegram alerts for newly detected pools. Both are required; without them the alert
# controls stay disabled and explain why. The token is read only on the server and is
# never sent to the browser.
#
# Create a bot with @BotFather to get the token, then send it a message and read the
# chat id from https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Route Krystal requests through a proxy.
#
# Cloudflare scores the requesting IP, and datacenter ranges are challenged far more readily
# than residential ones, so a deployment can be blocked where a laptop is not. Leave unset to
# call the API directly.
#
#   KRYSTAL_PROXY_URL=http://user:pass@proxy.example:8080
KRYSTAL_PROXY_URL=

# Chains to follow, as a comma separated list of ids. Defaults to all of them.
#   4663 Robinhood · 1 Ethereum · 8453 Base · 42161 Arbitrum · 10 Optimism · 137 Polygon
# Each chain costs a request per refresh and adds its pools to the background sweep, so narrow
# this if you only care about one.
# LP_CHAINS=4663,8453

# WalletConnect cloud project id, from cloud.reown.com. Optional: with it the connect dialog
# offers mobile and Coinbase wallets; without it, browser extension wallets only. Public by
# design, since it ships to every visitor.
# NEXT_PUBLIC_WC_PROJECT_ID=
